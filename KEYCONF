// The Last Hope custom controls.
// +user3 is intercepted by TacticalHUDHandler.InputProcess and routed as a
// per-player NetworkCommand. Compatible weapons do not use native User3 states.
// The offhand is a live mirrored PSprite, not duplicated weapon animation code.
addkeysection "The Last Hope" TheLastHope
addmenukey "Toggle Dual Wield" "+user3"
addmenukey "Tactical Dash" "+user2"
addmenukey "Go Prone (hold)" "+user1"
defaultbind "G" "+user3"
defaultbind "Q" "+user2"
defaultbind "MOUSE3" "+user1"
