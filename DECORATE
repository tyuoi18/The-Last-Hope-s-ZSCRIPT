// ---------------------------------------------------------------------------
// Realistic AI additions. These are separate replacements: the MVTR-REX
// definition and its attack/death states below remain unchanged.
//
// Patrols are emergent local wandering (A_Wander) with collision-aware movement,
// not a hand-authored waypoint system. A_LookEx limits view cone, sight range,
// and hearing distance. A_Chase keeps the original inherited attacks and does
// not use QUICKTORETALIATE, LOOKALLAROUND, or FASTCHASE.
//
// Standard Doom enemies
// ---------------------------------------------------------------------------
ACTOR TLH_AI_DoomImp : DoomImp replaces DoomImp
{
    States
    {
    Spawn:
        TROO A 8 A_LookEx(0, 0, 832, 384, 100, "See")
        TROO A 4 A_Wander
        TROO B 4 A_Wander
        TROO C 4 A_LookEx(0, 0, 832, 384, 100, "See")
        TROO D 4 A_Wander
        Loop

    See:
        TROO AABBCCDD 3 A_Chase("Melee", "Missile", CHF_DONTLOOKALLAROUND)
        Loop
    }
}

