// ---------------------------------------------------------------------------
// Main boss.
// ---------------------------------------------------------------------------
ACTOR MVTRBoss 31000
{
    Health 20000
    Radius 130
    Height 400
    Mass 12000
    Speed 8
    Scale 0.93
    PainChance 0
    DamageFactor 0.5
    DamageFactor "Normal", 0.5
    Monster
    +BOSS
    +BOSSDEATH
    +NOBLOOD
    +DONTMORPH
    SeeSound "cyber/sight"
    ActiveSound "cyber/active"
    PainSound "cyber/pain"
    DeathSound "cyber/death"
    Obituary "%o was eliminated by the MVTR-REX."

    States
    {
    Spawn:
        MVTR A 8 A_Look
        MVTR B 8 A_Look
        Loop

    // Phase 1 movement loop: stride 1 -> idle 1 -> stride 2 -> idle 1.
    See:
        TNT1 A 0 A_JumpIfHealthLower(15001, "SeePhase2")
        MVTR E 4 A_Chase
        MVTR A 4 A_Chase
        MVTR F 4 A_Chase
        MVTR A 4 A_Chase
        TNT1 A 0 A_JumpIfCloser(500, "CloseRange")
        TNT1 A 0 A_JumpIfCloser(1050, "MidRange")
        Goto LongRange

    SeePhase2:
        TNT1 A 0 A_SetSpeed(8)
        MVTR E 3 A_Chase
        MVTR A 3 A_Chase
        MVTR F 3 A_Chase
        MVTR A 3 A_Chase
        TNT1 A 0 A_JumpIfCloser(600, "CloseRange2")
        TNT1 A 0 A_JumpIfCloser(1250, "MidRange2")
        Goto LongRange2

    // ---------------- PHASE 1 ATTACK SELECTION ----------------
    LongRange:
        MVTR A 4 A_FaceTarget
        TNT1 A 0 A_Jump(72, "AttackCube")
        TNT1 A 0 A_Jump(150, "AttackMissiles")
        Goto AttackHeavyRocket

    MidRange:
        TNT1 A 0 A_Jump(58, "AttackCube")
        TNT1 A 0 A_Jump(85, "AttackGuns")
        TNT1 A 0 A_Jump(90, "AttackLaser")
        Goto AttackPlasma

    CloseRange:
        TNT1 A 0 A_Jump(180, "AttackStomp")
        Goto AttackGuns

    // ---------------- PHASE 1 ATTACKS ----------------
    AttackMissiles:
        MVTR A 5 A_FaceTarget
        MVTR C 4 A_CustomMissile("MVTRSeekingMissile", 362, 46, -8)
        MVTR D 4 A_CustomMissile("MVTRSeekingMissile", 362, 46, 0)
        MVTR C 4 A_CustomMissile("MVTRSeekingMissile", 362, 46, 8)
        MVTR A 8
        Goto See

    AttackGuns:
        MVTR A 4 A_FaceTarget
        MVTR C 0 A_PlaySound("weapons/chngun", CHAN_WEAPON)
        MVTR C 3 A_CustomBulletAttack(4.0, 2.0, 8, 4, "BulletPuff", 1000.0, CBAF_AIMFACING, AAPTR_TARGET, "None", 362.0, 46.0)
        MVTR D 3 A_CustomBulletAttack(4.0, 2.0, 8, 4, "BulletPuff", 1000.0, CBAF_AIMFACING, AAPTR_TARGET, "None", 362.0, 46.0)
        MVTR C 3 A_CustomBulletAttack(5.0, 2.5, 8, 4, "BulletPuff", 1000.0, CBAF_AIMFACING, AAPTR_TARGET, "None", 362.0, 46.0)
        MVTR A 8
        Goto See

    // Cubes launch from the round shoulder module rather than the cannon.
    AttackCube:
        MVTR A 5 A_FaceTarget
        MVTR B 4 A_PlaySound("weapons/bfgf", CHAN_WEAPON)
        MVTR A 4 A_CustomMissile("MVTRSpawnCube", 312, -46, -10)
        MVTR B 4 A_CustomMissile("MVTRSpawnCube", 312, -46, 0)
        MVTR A 4 A_CustomMissile("MVTRSpawnCube", 312, -46, 10)
        MVTR A 9
        Goto See

    AttackHeavyRocket:
        MVTR A 4 A_FaceTarget
        MVTR C 3 A_PlaySound("weapons/rocklf", CHAN_WEAPON)
        MVTR C 3 A_CustomMissile("MVTRHeavyRocket", 362, 46, -5)
        MVTR D 3 A_CustomMissile("MVTRHeavyRocket", 362, 46, 5)
        MVTR A 10
        Goto See

    // Railgun originates at the shoulder module. Idle frames avoid showing
    // the cannon muzzle-flash at a location different from the beam origin.
    AttackLaser:
        MVTR A 5 A_FaceTarget
        MVTR B 2 A_PlaySound("weapons/bfgf", CHAN_WEAPON)
        MVTR A 3 A_CustomRailgun(18, -46, "Red", "Yellow", 0, 0, 0, "BulletPuff", 0, 0, 1200, 4, 1, 1, "None", 312)
        MVTR B 3 A_CustomRailgun(18, -46, "Red", "Yellow", 0, 0, 0, "BulletPuff", 0, 0, 1200, 4, 1, 1, "None", 312)
        MVTR A 3 A_CustomRailgun(18, -46, "Red", "Yellow", 0, 0, 0, "BulletPuff", 0, 0, 1200, 4, 1, 1, "None", 312)
        MVTR A 8
        Goto See

    // Shoulder plasma burst.
    AttackPlasma:
        MVTR A 4 A_FaceTarget
        MVTR B 3 A_PlaySound("weapons/plasmaf", CHAN_WEAPON)
