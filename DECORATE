// ---------------------------------------------------------------------------
// Spawn cube inspired by the Icon of Sin. It homes toward the target; when
// it impacts, it flashes and releases a random Doom monster.
// ---------------------------------------------------------------------------
ACTOR MVTRSpawnCube : Actor
{
    Health 1
    Radius 10
    Height 10
    Speed 10
    Damage 0
    PROJECTILE
    +NOGRAVITY
    +SEEKERMISSILE
    +DROPOFF
    RenderStyle Add
    Alpha 0.95
    DeathSound "weapons/rocklx"

    States
    {
    Spawn:
        BOSF ABCD 3 Bright A_SeekerMissile(8, 14)
        Loop

    Death:
        TNT1 A 0 A_PlaySound("misc/teleport", CHAN_BODY)
        TNT1 A 0 A_SpawnItemEx("MVTRCubeFlash", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        TNT1 A 0 A_SpawnItemEx("MVTRDeathBlast", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        TNT1 A 0 A_Jump(102, "SpawnImp")
        TNT1 A 0 A_Jump(85, "SpawnDemon")
        TNT1 A 0 A_Jump(128, "SpawnShotgunGuy")
        TNT1 A 0 A_Jump(128, "SpawnCacodemon")
        Goto SpawnRevenant

    SpawnImp:
        TNT1 A 0 A_SpawnItemEx("DoomImp", 0, 0, -24, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Goto CubeEnd

    SpawnDemon:
        TNT1 A 0 A_SpawnItemEx("Demon", 0, 0, -24, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Goto CubeEnd

    SpawnShotgunGuy:
        TNT1 A 0 A_SpawnItemEx("ShotgunGuy", 0, 0, -24, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Goto CubeEnd

    SpawnCacodemon:
        TNT1 A 0 A_SpawnItemEx("Cacodemon", 0, 0, -24, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Goto CubeEnd

    SpawnRevenant:
        TNT1 A 0 A_SpawnItemEx("Revenant", 0, 0, -24, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Goto CubeEnd

    CubeEnd:
        TNT1 A 1
        Stop
    }
}

